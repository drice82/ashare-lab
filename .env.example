# 复制为 .env；不要提交真实 Token。
TUSHARE_TOKEN=
TUSHARE_HTTP_URL=https://api.tushare.pro
DATA_DIR=data
DATABASE_PATH=data/business.db
TZ=Asia/Shanghai
REQUESTS_PER_MINUTE=40
SYNC_CONCURRENCY=4
# 数据更新独立执行；筛选、定投、回测合计最多同时执行 1–2 个。
WORKER_RESEARCH_CONCURRENCY=2
API_HOST=127.0.0.1
API_ACCESS_TOKEN=
WEB_PORT=8080
# INTERNAL_NETWORK_ONLY 仅由 Compose 设置：API 不发布宿主端口。
# 宿主直接运行不应启用该选项。

DATA_MANAGEMENT_PASSWORD=
