# 复制为 .env；不要提交真实 Token。
TUSHARE_TOKEN=
TUSHARE_HTTP_URL=https://api.tushare.pro
DATA_DIR=data
DATABASE_PATH=data/business.db
TZ=Asia/Shanghai
REQUESTS_PER_MINUTE=40
SYNC_CONCURRENCY=4
# 数据更新独立执行；筛选、定投、回测合计最多同时执行 1–2 个。
WORKER_RESEARCH_CONCURRENCY=2
API_HOST=127.0.0.1
API_ACCESS_TOKEN=
WEB_PORT=8080
# INTERNAL_NETWORK_ONLY 仅由 Compose 设置：API 不发布宿主端口。
# 宿主直接运行不应启用该选项。

DATA_MANAGEMENT_PASSWORD=

# 信号通知：完成真实行情、Webhook、SMTP实收及退订验收后才设为true。
NOTIFICATION_AUTO_SEND=false
# 用Fernet.generate_key()在部署环境生成；API与Worker必须一致，持久保存，禁止提交。
NOTIFICATION_ENCRYPTION_KEY=
NOTIFICATION_PUBLIC_URL=http://localhost:8080
# 生产HTTPS设true；仅本机HTTP开发可设false。
NOTIFICATION_COOKIE_SECURE=true
NOTIFICATION_SESSION_DAYS=180
NOTIFICATION_SUBSCRIPTION_LIMIT=20
# 仅填写可信反向代理的IP/CIDR（逗号分隔），才信任它的X-Real-IP；默认忽略转发头。
NOTIFICATION_TRUSTED_PROXIES=
# Webhook由用户在账号与渠道页填写，仅支持公网HTTPS，无全局Bark服务器配置。
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=ashare-lab
